{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "packages": [
    "git:git@github.com:inwonakng/api-relay-server.git",
    {
      "source": "git:git@github.com:inwonakng/pi-extensions.git",
      "extensions": [
        "-extensions/zotero.ts",
        "-extensions/zotero-reader.ts"
      ]
    },
    "~/zotero-tools"
  ],
  "defaultTools": [
    "+codemode",
    "+spawn",
    "+spawn_control",
    "+workspace",
    "+question",
    "+todowrite",
    "+web_search",
    "+web_fetch"
  ],
  "defaultProvider": "relay",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "codemode": {
    "mode": "on",
    "inlineBudget": 3000
  }
}
