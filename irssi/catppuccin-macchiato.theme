# Catppuccin Macchiato adaptation of TankE theme for irssi
# Original TankE theme by Tanke <tanke@escomposlinux.org> SpZ@QuakeNet
#
# Adapted for a terminal whose ANSI palette is Catppuccin Macchiato.
# In particular, this version avoids colored statusbar backgrounds and
# uses the terminal default background instead.
#
# Expected Ghostty ANSI palette:
#   0  #494d64   1  #ed8796   2  #a6da95   3  #eed49f
#   4  #8aadf4   5  #f5bde6   6  #8bd5ca   7  #a5adcb
#   8  #5b6078   9  #ed8796  10  #a6da95  11  #eed49f
#  12  #8aadf4  13  #f5bde6  14  #8bd5ca  15  #b8c0e0
#
# Recommended terminal background: #2c2e3d
# Recommended terminal foreground: #cad3f5
#
# Install as ~/.irssi/catppuccin-macchiato.theme
# Then in Irssi:
#   /set theme catppuccin-macchiato
#
# To reload changes while editing:
#   /reload
#
# NOTE: In Irssi themes, %n restores the previous color. %N resets to the
# terminal default. Statusbars here intentionally use %N as their background.

default_color = "-1";

replaces = { "=" = "%w$0-%n"; };

abstracts = {

  # text to insert at the beginning of each non-message line
  line_start = "";
  ts = ">> ";

  # subdued timestamp
  timestamp = "%K[%N$0-%K]%n";

  # emphasis / errors
  hilight = "%_$0-%_";
  error = "%R$0-%n";

  # common entities
  channel = "%B$0-%n";
  nick = "%Y$0-";
  nickhost = "%W$0-";
  server = "%C$0-%n";
  comment = "%w$0-%n";
  reason = "%c[{comment $0-}%c]%n";
  mode = "%C$0-%n";

  channick_hilight = "%B$0-%n";
  chanhost_hilight = "{nickhost %W$0-}";

  # nick/host is printed (parts, quits, etc.)
  channick = "%R$0-%n";
  chanhost = "{nickhost %W$0-%n}";

  channelhilight = "%W$0-%n";
  ban = "%W$0-%n";

  # message nicks
  msgnick = "%m(%y$0%C$1-%m) %|";

  ownmsgnick = "{msgnick $0 $1}%Y%n";
  ownnick = "%G$0%C$1%n";

  pubmsgnick = "{msgnick $0 $1}%n";
  pubnick = "%C$0$1%n";

  pubmsgmenick = "{msgnick %_$0%_ $1}%W";
  menick = "%Y$0%Y$1";

  pubmsghinick = "%m(%M$1%Y$2%m)%W ";

  msgchannel = "%w:%B$0-%n";

  # private messages
  privmsg = "%m$0%n %n%|";
  ownprivmsg = "%C--> %n$1%C:%n %|";
  ownprivmsgnick = "%m(%W$0-%m) %|";
  ownprivnick = "%Y$0";
  privmsgnick = "{msgnick %m%Y$0%m }%W%|";

  # Actions (/me)
  action_core = "* $0-";
  action = "{action_core %N$0-%n} ";
  ownaction = "%C{action $0-}%n";
  pubaction = "{action $0-}";
  ownaction_target = "{action_core $0}:$1 ";
  pvtaction_query = "{action $0-}";
  pvtaction = "* (%W$0-%n) ";

  # notices
  ownnotice = "%Wnotice %M-> %Y$1%n%W:%n %|";
  notice = "%m- %Y$0 %n %|";
  pubnotice_channel = "%M$0-%W: %|";
  pvtnotice_host = "%n ($0-)%|";
  servernotice = "%G[$0-]%n %|";

  # CTCPs
  ownctcp = "%W-> $0 to %Y$1%n: ";
  ctcp = "%W-> %n$0-%n";

  # wallops
  wallop = "%W$0-%n: ";
  wallop_nick = "%n$0-";
  wallop_action = "%W * $0-%n ";

  # netsplits
  netsplit = "%R$0-%n";
  netjoin = "%G$0-%n";

  # /names list
  names_nick = "%K[%C$0%B$1-%K] ";
  names_users = "%K[%G$0-%n";
  names_channel = "%G$0-%n%K]";

  # DCC
  dcc = "%m- $0-%n";
  dccfile = "$0-";

  # DCC chat, own msg/action
  dccownmsg = "%Y$1%n ";
  dccownnick = "%M$0-%n";
  dccownaction = "{action $0-}";
  dccownaction_target = "{action_core $0}%K:%C$1%n ";

  # DCC chat, others
  dccmsg = "[%G$1-%K(%g$0%K)%n] ";
  dccquerynick = "%G$0-%n";
  dccaction = "%W (*dcc*) $0-%n %|";

  #
  ## StatusBar
  #
  # IMPORTANT: use terminal default background instead of ANSI blue/reverse.
  # This keeps Catppuccin's dark Ghostty background and uses accents only
  # for foreground text.
  sb_background = "%0";
  sb_default_bg = "%0";
  sb_prompt_bg = "%N";
  sb_info_bg = "%0";

  sb = "%B[%W$0-%B] ";
  sbstart = "";
  sbend = " ";

  sbmode = " %B(%C+%W$0-%B)%n";
  sbaway = " (%YzZzZ%n)";
  sbservertag = "%K:%n $0";
  sbmore = "%_%Y-- more --%_%n";
  sblag = "{sb %WLag: %R$0-%n}";
  sbmail = "{sb %WMail: %C$0-%n}";

  # Window activity:
  # separator = dim surface; text = subtext; message = blue;
  # highlight = yellow; urgent highlight = magenta.
  sb_act_sep = "%K$*%n";
  sb_act_text = "%w$*%n";
  sb_act_msg = "%B$*%n";
  sb_act_hilight = "%Y$*%n";
  sb_act_hilight_color = "%_%M$1-%_%n";

};

formats = {
  "fe-common/core" = {
    join = "%B{ts}%n{channick_hilight $0} joins {channel $2}";
    nick_changed = "%M{ts}%n{channick $0} is now known as {channick $1}";
    quit = "%K{ts}%nSignOff: {channick $0} {reason $2}";
    quit_once = "%K{ts}%nSignOff: {channick $0} {reason $2}";
    part = "%K{ts}%n{channick_hilight $0} parts {channel $2}";
    kick = "%R{ts}%nKick for {nick $0} by {nick $2} from {channel $1} {reason $3}";
    your_nick_changed = "%M{ts}%n{channick $0} is now known as {channick $1}";
    endofnames = "%Y{ts}%nStats {channel $0}: {hilight +o}[$2] {hilight +v}[$4] {hilight -o}[$5] Total: {hilight $1}";
    new_topic = "%Y{ts}%nTopic change on {channel $1} by $0: $2";
    topic_unset = "%Y{ts}%nTopic unset on {channel $1} by $0";
    line_start_irssi = "{line_start}";
    servertag = "$0%K/%n";
    daychange = "%K[%B00:00%K] %W{ts}%nDay changed to %%d %%b %%Y";
    invite = "%M{ts}%n{hilight $0}!$2 invites you to {channel $1}";
    own_msg_private_query = "%m(%C$2%m)%n %|$1";
    msg_private_query = "%m(%B$0%m)%n %|$2";
    timestamp = "{timestamp $Z} ";
    own_msg_private = "{ownprivmsg msg $0}$1";
  };

  "fe-common/irc" = {
    whois = "%G·---··· %W$0 %C($1@$2) %K]%G -----········ ·%n%:%G|%C    Ircname %n $3%:%G|%C     Domain %n \"$4\"";
    whois_channels = "%G|   %CChannels %n %|$1";
    whois_idle = "%G|       %CIdle %n $1 days $2 hours $3 mins $4 secs";
    whois_server = "%G|     %CServer %n %|$1 [$2]";
    whois_idle_signon = "%G|       %CIdle %n $1 days $2 hours $3 mins $4 secs%:%G|     %CSignon %n $5";
    whois_oper = "%G|   %COperator %n $0 is an IRC Operator";
    whois_modes = "%G|      %CModes %n $1";
    end_of_whois = "%G| %n";
    whois_away = "%G|       %CAway %n %|$1";
    whois_registered = "%G| %CRegistered %n has registered this nick";
    whowas = "%G·---··· %W$0 %C($1@$2) %K]%G -----········ ·%n%:%G|%C    Ircname %G|%n $3";
    end_of_whowas = "%G| %n";
    chanmode_change = "%C{ts}%nMode {channel $0} {mode $1} by {nick $2}";
    server_chanmode_change = "%C{ts}%n{netsplit NetHack} {channel $0} {mode $1} by {nick $2}";
    channel_mode = "{ts}Mode for channel {channel $0} is {mode $1}";
    topic = "%Y{ts}%nTopic on {channel $0}: $1";
    no_topic = "%Y{ts}%nNo topic set for {channel $0}";
    topic_info = "%Y{ts}%nTopic set by $0 {comment $1}";
    away = "{ts}You have been marked as being away";
    unaway = "{ts}You are no longer marked as being away";
    nick_away = "%W{ts}%n$0 is away: $1";
    channel_synced = "%G{ts}%nChannel {channel $0} was synced in {hilight $1} seconds";
    inviting = "%M{ts}%nInviting $0 to channel {channel $1}";
    whois_oper_type = "%G|   %COperator %n $0 is an IRC Operator";
  };

  "fe-text" = {
    lastlog_start = "%_------- %C-%n %_{hilight Lastlog}%_:";
    lastlog_end = "%_------- %C-%n%_ {hilight End of lastlog}%_";
  };

  "fe-common/irc/dcc" = {
    dcc_ctcp = "{dcc %G %n DCC CTCP {hilight $1} received from {hilight $0}: $2}";
    own_dcc_query = "%m%n{ownmsgnick $0 %m%n}$2";
    dcc_msg_query = "{privmsgnick $0}$1";
    own_dcc_action = " %m*%n {dccownaction_target $0 $1}$2";
    own_dcc_action_query = " %m*%n {dccownaction $0}$2";
  };

  "fe-common/irc/notifylist" = {
    notify_join = "%B{ts}%nSignon detected: {nick $0} ($1@$2) /$4/";
    notify_part = "%K{ts}%nSignoff detected: {nick $0} /$4/";
    notify_away = "%M{ts}%nStatus change: {nick $0} /$5/ is now away: $4";
    notify_unaway = "%G{ts}%nStatus change: {nick $0} /$4/ is now unaway";
    notify_unidle = "%G{ts}%nStatus change: {nick $0} /$5/ just stopped idling";
    notify_list = "$[9]0{hilight :} $[6]1 | $[5]2 | $3";
  };
};
