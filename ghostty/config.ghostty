font-family = IBM Plex Mono
font-size = 15
shell-integration-features = no-cursor
cursor-style = block
# window-decoration = none
macos-titlebar-style = hidden
font-thicken = true
font-style = Light
confirm-close-surface = false

# theme stuff
palette = 0=#2a2a2a
palette = 1=#ff0000
palette = 2=#9bdc73
palette = 3=#e7bf00
palette = 4=#396bd7
palette = 5=#b449be
palette = 6=#66ccff
palette = 7=#bbbbbb
palette = 8=#666666
palette = 9=#b85c86
palette = 10=#7fc49b
palette = 11=#f3d64e
palette = 12=#709aed
palette = 13=#db67e6
palette = 14=#7adff2
palette = 15=#ffffff

background = #202227
foreground = #cad3f5
cursor-color = #f4dbd6
cursor-text = #181926
selection-background = #3a3e53
selection-foreground = #cad3f5
split-divider-color = #363a4f

# special override for pi to make alt-backspace work
keybind = alt+backspace=text:\x1b\x7f
